ARG NODE_IMAGE=node:24.18.0-bookworm-slim
FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS build
WORKDIR /app
COPY components/workboard/package.json components/workboard/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY components/workboard/ ./
RUN npm run build

FROM ${NODE_IMAGE}
WORKDIR /app
COPY --from=build /app/server/ ./server/
COPY --from=build /app/dist/ ./dist/
RUN install -d -o node -g node -m 0700 /data
ENV NODE_ENV=production WORKBOARD_HOST=0.0.0.0 WORKBOARD_PORT=4180 WORKBOARD_DB=/data/workboard.sqlite
USER node
EXPOSE 4180
CMD ["node", "server/start.mjs"]
