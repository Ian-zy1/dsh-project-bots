# Insert inside the existing authenticated DSH server block. Preserve all other locations.
# Use the same realm and password file as /dsh/. Do not publish the AW container port.
location = /aw {
    auth_basic "DSH";
    auth_basic_user_file /data/heimdall/nginx/conf/dsh.htpasswd;
    rewrite ^ /aw/ last;
}
location ^~ /aw/ {
    auth_basic "DSH";
    auth_basic_user_file /data/heimdall/nginx/conf/dsh.htpasswd;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $aw_backend agent-workboard:4180;
    rewrite ^/aw/(.*)$ /$1 break;
    proxy_pass http://$aw_backend;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization "";
    client_max_body_size 512k;
}
