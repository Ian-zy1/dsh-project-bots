  "requirements": [
    {
      "id": "req-display-v0",
      "projectId": "proj-workboard",
      "title": "首个只读展示版",
      "goal": "让用户快速找到项目中的需求与任务，辨认当前状态，并比较同一任务下不同 Agent 的候选实现与证据。",
      "scope": [
        "项目入口、任务列表与任务详情；支持项目切换和状态筛选。",
        "同一任务展示多份候选，分别记录执行、候选 SHA、验证与评审。",
        "活动记录标明时间、主体与来源。",
        "全部使用明确标注的演示数据，不接真实数据源。"
      ],
      "acceptanceCriteria": [
        "能找到任务，并理解其目标、状态和验收要求。",
        "能比较同一任务的不同候选，状态和证据不会串用。",
        "缺失证据明确显示为未知或未提供。",
        "具备空列表、无候选和读取失败的呈现。",
        "桌面和窄屏均可正常阅读。"
      ],
      "plans": [
        {
          "version": "plan-v1",
          "approvedAt": "2026-11-10T09:00:00+08:00",
          "approvedBy": "Owner-Demo",
          "sourceRef": "演示计划记录 plan-v1",
          "note": "技术栈、单页布局与演示数据规模已确认。"
        }
      ],
