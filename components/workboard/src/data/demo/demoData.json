    {
      "id": "req-evidence",
      "projectId": "proj-workboard",
      "title": "候选证据与状态区分",
      "goal": "在同一任务中分别呈现执行结束、评审结论与最终采纳，且评审结论只对明确的候选 SHA 生效。",
      "scope": [
        "候选卡片分区展示执行、验证、评审与阻塞。",
        "当评审 SHA 与当前候选 SHA 不一致时，明确提示结论不能沿用。",
        "缺失的分支、PR、SHA 或证据显示为未提供或未知。"
      ],
      "acceptanceCriteria": [
        "同一任务的两份候选状态、SHA 和评审结论不会串用。",
        "评审针对的 SHA 与候选当前 SHA 同时可见。",
        "执行结束、评审通过与最终采纳是三个独立字段。",
        "阻塞原因与待处理事项可见。"
      ],
